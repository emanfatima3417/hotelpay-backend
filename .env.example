# Copy this file to .env for local testing.
# On Render, set these as Environment Variables in the dashboard instead —
# do not upload a real .env file to GitHub.

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string

# Optional — only needed for AI screenshot reading and the AI chat assistant.
# Get a key at https://console.anthropic.com -> API Keys. Leave blank to run
# the app without AI features (manual entry will still work fine).
ANTHROPIC_API_KEY=

# Postgres connection string from your free database host (e.g. Neon).
# Looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

PORT=3000
